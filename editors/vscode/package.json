{
  "name": "grepnavi-lsp",
  "displayName": "grepnavi LSP",
  "description": "Definition, references and call hierarchy for C/C++ via grepnavi -lsp",
  "version": "0.1.3",
  "publisher": "grepnavi-local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:c",
    "onLanguage:cpp"
  ],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "grepnavi",
      "properties": {
        "grepnavi.serverPath": {
          "type": "string",
          "default": "grepnavi",
          "scope": "machine",
          "description": "grepnavi 実行ファイルのパス。-lsp 付きで起動される。PATH に無い場合はフルパスを指定する。machine スコープ: 開いたリポジトリの .vscode/settings.json からは変更できない（任意 exe を起動させないため）"
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
